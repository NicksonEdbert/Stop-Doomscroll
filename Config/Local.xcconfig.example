PRODUCT_BUNDLE_IDENTIFIER = com.yourname.stopdoomscroll

// Optional. Your 10-character team ID. If you leave it empty, pick your
// "(Personal Team)" in Xcode under Signing & Capabilities instead.
DEVELOPMENT_TEAM =
